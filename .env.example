# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ── Búsqueda y notificación ───────────────────────────────────────────────────
# Palabras clave para notificar. Vacío = notificar TODOS los artículos.
KEYWORDS=bici,patinete,silla,lego,fitness

# ── Autoreserva ───────────────────────────────────────────────────────────────
# Activar/desactivar autoreserva (true/false)
AUTORESERVE_ENABLED=false

# Palabras clave para intentar reserva automática (subconjunto de KEYWORDS)
AUTORESERVE=lego

# Credenciales de tu cuenta ReMAD
REMAD_EMAIL=tu@email.com
REMAD_PASS=tupassword

# Segundos esperando el código SMS antes de cancelar (recomendado: 90-120)
SMS_TIMEOUT=120

# Puerto para el webhook de Tasker (dejar vacío para desactivar)
# Tasker hará: POST http://<IP-PI>:<puerto>/sms  con body: {"code": "123456"}
SMS_WEBHOOK_PORT=8765

# ── Watchlist ─────────────────────────────────────────────────────────────────
# Archivo con artículos a vigilar 24/7 (uno por línea: hash o URL completa)
# Se monitoriza aunque el catálogo esté fuera de horario (artículos reservados
# que caducan o son cancelados). Si coincide con AUTORESERVE, se intenta reservar.
WATCHLIST_FILE=watchlist.txt

# ── Comportamiento ────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=10
DB_FILE=sent_hashes.txt

# ── Logging ───────────────────────────────────────────────────────────────────
# WARNING = silencioso: solo notificaciones enviadas y errores (recomendado en Pi)
# INFO    = verbose: muestra cada búsqueda, página y ciclo (útil para debug)
LOG_LEVEL=WARNING
