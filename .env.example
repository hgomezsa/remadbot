# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ── Búsqueda ──────────────────────────────────────────────────────────────────
# Palabras clave separadas por coma. Vacío = notificar TODOS los artículos.
KEYWORDS=bici,patinete,silla

# ── Comportamiento ────────────────────────────────────────────────────────────
# Segundos entre cada comprobación del catálogo
POLL_INTERVAL_SECONDS=120

# Fichero donde se guardan los hashes ya notificados (evita duplicados)
DB_FILE=sent_hashes.txt

# ── Logging ───────────────────────────────────────────────────────────────────
# WARNING  → silencioso: sólo notificaciones enviadas y errores  (recomendado en Pi)
# INFO     → verbose: muestra cada búsqueda, página y ciclo     (útil para debug)
LOG_LEVEL=WARNING
